# رابط PostgreSQL من Neon — لا تضع قيمة حقيقية داخل GitHub
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# أضفه بعد أول نشر على Vercel لضمان أن QR والمشاركة يستخدمان نطاقك
PUBLIC_APP_URL=https://your-project.vercel.app

NEXT_PUBLIC_LIVEKIT_URL=wss://your-workspace.livekit.cloud
LIVEKIT_API_KEY=your-api-key-here
LIVEKIT_API_SECRET=your-api-secret-here